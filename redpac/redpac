#!/usr/bin/env bash
#
# redpac — installs the "main programs" of this setup (the st terminal,
# the fish shell, the Nyxt web browser, Neovim configured with LazyVim,
# and a couple of devops tools: the bottom system monitor, the
# lazydocker Docker TUI, and the slock screen locker) through whatever
# native package manager the host distro provides: pacman on Arch
# Linux, or emerge/Portage on Gentoo. Because installation goes through
# the real package manager, required libraries are pulled in
# automatically as ordinary dependencies — there is no separate
# "install libs" step.
#
# Usage:
#   redpac install <st|fish|nyxt|lazyvim|bottom|lazydocker|slock|all>
#   redpac list
#   redpac help

set -euo pipefail

prog_name="redpac"
managed_packages=(fish st nyxt lazyvim bottom lazydocker slock)

# is_installed reports whether the named managed package is already set
# up. lazyvim is special-cased: it's "installed" once Neovim is present
# and pointed at a LazyVim config, not a binary of its own. bottom is
# special-cased because its package name doesn't match its binary name
# (the binary is called btm).
is_installed() {
	case "$1" in
	lazyvim)
		command -v nvim >/dev/null 2>&1 && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/config/lazy.lua" ]
		;;
	bottom)
		command -v btm >/dev/null 2>&1
		;;
	*)
		command -v "$1" >/dev/null 2>&1
		;;
	esac
}

# detect_pm prints the package manager found on this host: "pacman",
# "emerge", or "none".
detect_pm() {
	if command -v pacman >/dev/null 2>&1; then
		echo "pacman"
	elif command -v emerge >/dev/null 2>&1; then
		echo "emerge"
	else
		echo "none"
	fi
}

# aur_helper prints the first AUR helper found in PATH (yay, paru), or
# nothing if none is installed.
aur_helper() {
	local helper
	for helper in yay paru; do
		if command -v "$helper" >/dev/null 2>&1; then
			echo "$helper"
			return
		fi
	done
}

# as_root runs its arguments as root, via sudo if we aren't already root.
as_root() {
	if [ "$(id -u)" -eq 0 ]; then
		"$@"
	else
		sudo "$@"
	fi
}

pm="$(detect_pm)"

require_pm() {
	if [ "$pm" = "none" ]; then
		echo "$prog_name: no supported package manager found (need pacman on Arch Linux or emerge on Gentoo)" >&2
		exit 1
	fi
}

usage() {
	cat <<EOF
usage: $prog_name <command> [package]

commands:
  install <pkg|all>   install one of: ${managed_packages[*]}, or all of them
  list                show which managed packages are installed
  help                show this help

$prog_name installs through your distro's native package manager
(pacman on Arch Linux, emerge/Portage on Gentoo), so required
libraries come in automatically as ordinary dependencies.
EOF
}

# install_fish installs the fish shell.
install_fish() {
	if is_installed fish; then
		echo "fish: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		as_root pacman -Sy --needed --noconfirm fish
		;;
	emerge)
		as_root emerge --ask=n app-shells/fish
		;;
	esac
}

# install_st installs the suckless st terminal.
install_st() {
	if is_installed st; then
		echo "st: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		as_root pacman -Sy --needed --noconfirm st
		;;
	emerge)
		as_root emerge --ask=n x11-terms/st
		;;
	esac
}

# install_nyxt installs the Nyxt web browser. Nyxt is AUR-only on Arch
# and lives outside the main Portage tree on Gentoo, so both branches
# fall back to clear manual instructions when the automatic path fails.
install_nyxt() {
	if is_installed nyxt; then
		echo "nyxt: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		install_nyxt_pacman
		;;
	emerge)
		install_nyxt_emerge
		;;
	esac
}

install_nyxt_pacman() {
	local helper
	helper="$(aur_helper)"
	if [ -n "$helper" ]; then
		"$helper" -S --needed --noconfirm nyxt-bin && return 0
		"$helper" -S --needed --noconfirm nyxt && return 0
	fi
	cat >&2 <<EOF
$prog_name: nyxt is AUR-only and no AUR helper (yay/paru) was found.
Install one first (e.g. 'pacman -S --needed yay'), or build it manually:
  git clone https://aur.archlinux.org/nyxt-bin.git
  cd nyxt-bin && makepkg -si
EOF
	return 1
}

install_nyxt_emerge() {
	local category
	for category in www-client/nyxt net-www/nyxt; do
		if as_root emerge --ask=n "$category" 2>/dev/null; then
			return 0
		fi
	done
	cat >&2 <<EOF
$prog_name: nyxt was not found in the main Portage tree.
Enable the GURU overlay and try again:
  sudo eselect repository enable guru
  sudo emaint sync --repo guru
  sudo emerge --ask=n www-client/nyxt
EOF
	return 1
}

# install_lazyvim installs Neovim plus its build/runtime tooling, then
# bootstraps the LazyVim starter config into $XDG_CONFIG_HOME/nvim if no
# Neovim config exists there yet. It never overwrites an existing config.
install_lazyvim() {
	if is_installed lazyvim; then
		echo "lazyvim: already installed"
		return 0
	fi

	if ! command -v nvim >/dev/null 2>&1; then
		case "$pm" in
		pacman)
			as_root pacman -Sy --needed --noconfirm neovim git ripgrep fd
			;;
		emerge)
			as_root emerge --ask=n app-editors/neovim dev-vcs/git sys-apps/ripgrep sys-apps/fd
			;;
		esac
	fi

	local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
	if [ -e "$config_dir" ]; then
		cat >&2 <<EOF
$prog_name: $config_dir already exists, leaving it alone.
To switch it to LazyVim yourself:
  mv $config_dir ${config_dir}.bak
  git clone https://github.com/LazyVim/starter $config_dir
  rm -rf $config_dir/.git
EOF
		return 1
	fi

	git clone --depth=1 https://github.com/LazyVim/starter "$config_dir"
	rm -rf "$config_dir/.git"
	echo "lazyvim: installed into $config_dir (run 'nvim' once to finish bootstrapping plugins)"
}

# install_bottom installs the bottom system/process monitor (binary: btm).
install_bottom() {
	if is_installed bottom; then
		echo "bottom: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		as_root pacman -Sy --needed --noconfirm bottom
		;;
	emerge)
		as_root emerge --ask=n sys-process/bottom
		;;
	esac
}

# install_slock installs the suckless slock screen locker.
install_slock() {
	if is_installed slock; then
		echo "slock: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		as_root pacman -Sy --needed --noconfirm slock
		;;
	emerge)
		as_root emerge --ask=n x11-misc/slock
		;;
	esac
}

# install_lazydocker installs the lazydocker Docker/Compose TUI. It's an
# official Arch package, but on Gentoo it currently lives only in
# third-party overlays, so that branch falls back to clear instructions.
install_lazydocker() {
	if is_installed lazydocker; then
		echo "lazydocker: already installed"
		return 0
	fi
	case "$pm" in
	pacman)
		as_root pacman -Sy --needed --noconfirm lazydocker
		;;
	emerge)
		install_lazydocker_emerge
		;;
	esac
}

install_lazydocker_emerge() {
	if as_root emerge --ask=n app-containers/lazydocker 2>/dev/null; then
		return 0
	fi
	cat >&2 <<EOF
$prog_name: lazydocker was not found in the main Portage tree (it
currently only lives in third-party overlays). Try the GURU overlay:
  sudo eselect repository enable guru
  sudo emaint sync --repo guru
  sudo emerge --ask=n app-containers/lazydocker
If that doesn't have it either, install it directly with Go:
  go install github.com/jesseduffield/lazydocker@latest
EOF
	return 1
}

list_status() {
	echo "package manager: $pm"
	local p
	for p in "${managed_packages[@]}"; do
		if is_installed "$p"; then
			printf "  %-11s installed\n" "$p"
		else
			printf "  %-11s not installed\n" "$p"
		fi
	done
}

main() {
	case "${1:-help}" in
	install)
		require_pm
		case "${2:-}" in
		fish) install_fish ;;
		st) install_st ;;
		nyxt) install_nyxt ;;
		lazyvim) install_lazyvim ;;
		bottom) install_bottom ;;
		lazydocker) install_lazydocker ;;
		slock) install_slock ;;
		all)
			local failed=0
			install_fish || failed=1
			install_st || failed=1
			install_nyxt || failed=1
			install_lazyvim || failed=1
			install_bottom || failed=1
			install_lazydocker || failed=1
			install_slock || failed=1
			exit "$failed"
			;;
		*)
			echo "$prog_name: unknown package '${2:-}' (want one of: ${managed_packages[*]}, all)" >&2
			usage
			exit 1
			;;
		esac
		;;
	list)
		require_pm
		list_status
		;;
	help | --help | -h)
		usage
		;;
	*)
		echo "$prog_name: unknown command '$1'" >&2
		usage
		exit 1
		;;
	esac
}

main "$@"
